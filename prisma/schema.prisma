generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// better-auth — gerado por `npm run auth:generate` (plugins username, twoFactor,
// admin; rateLimit.storage = "database"; additionalFields.mustChangePassword).
// Ao atualizar o better-auth, gere de novo e compare com este bloco.
// ─────────────────────────────────────────────────────────────────────────────
model User {
  id                 String        @id
  name               String
  email              String
  emailVerified      Boolean       @default(false)
  image              String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  username           String?
  displayUsername    String?
  twoFactorEnabled   Boolean?      @default(false)
  role               String?
  banned             Boolean?      @default(false)
  banReason          String?
  banExpires         DateTime?
  mustChangePassword Boolean       @default(true)
  sessions           Session[]
  accounts           Account[]
  twofactors         TwoFactor[]
  gitlabTokens       GitLabToken[]
  auditLogs          AuditLog[]
  adminScans         AdminScan[]

  @@unique([email])
  @@unique([username])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  @@index([secret])
  @@index([userId])
  @@map("twoFactor")
}

model RateLimit {
  id          String @id
  key         String
  count       Int
  lastRequest BigInt

  @@unique([key])
  @@map("rateLimit")
}

// ─────────────────────────────────────────────────────────────────────────────
// Aplicação
// ─────────────────────────────────────────────────────────────────────────────
enum GitLabTokenStatus {
  ACTIVE // em uso
  ROTATED // substituído por rotação feita na ferramenta
  REPLACED // substituído manualmente / desvinculado
  REVOKED // o GitLab respondeu 401
  REVOKED_UNKNOWN // rotação com resultado ambíguo
}

model GitLabToken {
  id             String            @id @db.Uuid
  userId         String            @map("user_id")
  user           User              @relation(fields: [userId], references: [id], onDelete: Restrict)

  gitlabBaseUrl  String            @map("gitlab_base_url")
  gitlabUserId   Int               @map("gitlab_user_id")
  gitlabUsername String            @map("gitlab_username")
  gitlabIsAdmin  Boolean           @map("gitlab_is_admin")
  gitlabTokenId  Int               @map("gitlab_token_id")
  name           String
  scopes         String[]
  capabilities   String[]
  expiresAt      DateTime?         @map("expires_at") @db.Date
  status         GitLabTokenStatus @default(ACTIVE)
  // Uma conta pode ter vários tokens ATIVOS; exatamente um é o padrão (índices parciais únicos na migration).
  isDefault      Boolean           @default(false) @map("is_default")

  // AES-256-GCM, AAD = `${userId}:${id}`. Anulados na retenção (30 dias após inativação).
  ciphertext     Bytes?
  iv             Bytes?
  authTag        Bytes?            @map("auth_tag")
  keyVersion     String            @map("key_version")
  fingerprint    String

  rotatedFromId  String?           @unique @map("rotated_from_id") @db.Uuid
  rotatedFrom    GitLabToken?      @relation("Rotation", fields: [rotatedFromId], references: [id])
  rotatedTo      GitLabToken?      @relation("Rotation")

  createdAt      DateTime          @default(now()) @map("created_at")
  inactivatedAt  DateTime?         @map("inactivated_at")

  @@index([userId, status])
  @@map("gitlab_token")
}

enum AuditResult {
  SUCCESS
  FAILURE
  PARTIAL
  UNKNOWN
}

model AuditLog {
  id            String      @id @default(uuid(7)) @db.Uuid
  actorUserId   String?     @map("actor_user_id")
  actor         User?       @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  actorUsername String?     @map("actor_username")
  action        String
  result        AuditResult
  targetType    String?     @map("target_type")
  targetId      String?     @map("target_id")
  targetLabel   String?     @map("target_label")
  reason        String?
  errorCode     String?     @map("error_code")
  metadata      Json?
  ipAddress     String?     @map("ip_address")
  userAgent     String?     @map("user_agent")
  createdAt     DateTime    @default(now()) @map("created_at")

  @@index([actorUserId, createdAt])
  @@index([targetType, targetId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
  @@map("audit_log")
}

// Configurações editáveis na interface (valor em JSON). Padrões vêm do código/env quando a chave não existe.
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")

  @@map("app_setting")
}

enum AdminScanKind {
  CLEANUP // varredura de tokens/chaves SSH a revogar
  PAT_LIFETIME // simulação do efeito de limitar a validade máxima do PAT no GitLab
  VAULT // inventário dos tokens dos projetos-cofre e plano de criação/rotação
}

enum AdminScanStatus {
  RUNNING
  DONE
  FAILED
}

// Resultado de uma varredura (dry-run). A execução só age sobre itens que constam aqui.
model AdminScan {
  id          String          @id @db.Uuid
  kind        AdminScanKind
  actorUserId String          @map("actor_user_id")
  actor       User            @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  params      Json
  status      AdminScanStatus @default(RUNNING)
  progress    Json?
  items       Json?
  summary     Json?
  error       String?
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  finishedAt  DateTime?       @map("finished_at")

  @@index([actorUserId, createdAt])
  @@map("admin_scan")
}
