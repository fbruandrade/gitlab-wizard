# Copie para .env e preencha. Gere segredos com:  openssl rand -base64 32

# ── Banco (usado pelo docker-compose e pelo `npm run dev`) ──────────────────
POSTGRES_DB=gitlab_wizard
POSTGRES_SUPERUSER_PASSWORD=
APP_MIGRATOR_PASSWORD=
APP_RUNTIME_PASSWORD=
DB_PORT=5433
# App no host (npm run dev): Postgres do compose via localhost. Mantenha a porta igual a DB_PORT.
DATABASE_URL=postgresql://app_runtime:<APP_RUNTIME_PASSWORD>@localhost:5433/gitlab_wizard
DATABASE_MIGRATION_URL=postgresql://app_migrator:<APP_MIGRATOR_PASSWORD>@localhost:5433/gitlab_wizard

# ── Autenticação (better-auth) ──────────────────────────────────────────────
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Header com o IP real do cliente, definido pelo seu proxy reverso (ex.: x-forwarded-for). Vazio = sem IP confiável:
# o rate limit de login passa a usar um único balde compartilhado. NUNCA aponte para um header que o cliente possa forjar.
CLIENT_IP_HEADER=
AUTH_RATE_LIMIT_SIGNIN_MAX=5
# Origens extras aceitas pelo better-auth (separadas por vírgula), se a app for acessada por mais de uma URL.
BETTER_AUTH_TRUSTED_ORIGINS=
REQUIRE_APP_2FA=true
SESSION_MAX_AGE_HOURS=8
SESSION_IDLE_MINUTES=30
FRESH_SESSION_MINUTES=15

# ── GitLab ──────────────────────────────────────────────────────────────────
GITLAB_BASE_URL=https://gitlab.example.com
GITLAB_TIMEOUT_MS=10000
# GitLab com certificado AUTO-ASSINADO / CA interna:
#  1) Preferível: confie na CA da empresa →  NODE_EXTRA_CA_CERTS=/certs/ca.pem  (monte o arquivo no container)
#  2) Sem CA para confiar: GITLAB_TLS_INSECURE=true ignora a verificação do certificado SÓ nas chamadas ao GitLab
#     (o PAT trafega sem garantia de que o servidor é o certo; a UI exibe um aviso permanente).
GITLAB_TLS_INSECURE=false
GITLAB_ADMIN_MODE_ENABLED=true
TOKEN_MAX_LIFETIME_DAYS=365

# ── Cifragem do PAT (AES-256-GCM): versao:base64(32 bytes), separadas por vírgula ──
TOKEN_ENCRYPTION_KEYS=v1:
TOKEN_ENCRYPTION_ACTIVE_KEY=v1

# Habilita POST /api/internal/maintenance (Authorization: Bearer <segredo>), chamado por um CronJob. Vazio = 404.
MAINTENANCE_SECRET=

# Rotação automática dos cofres de token (docs/13 §14): intervalo, em minutos, do agendador interno. 0 = desligado.
# Só age se um admin habilitar em /admin/vault. Também dá para disparar por POST /api/internal/vault-auto (mesmo segredo).
VAULT_AUTO_INTERVAL_MINUTES=60

# Primeiro admin (usado só por `npm run create-admin`)
SEED_ADMIN_USERNAME=
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=

LOG_LEVEL=info
