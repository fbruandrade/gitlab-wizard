{
  "name": "gitlab-wizard",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "auth:generate": "auth generate --config src/server/auth/auth.generate.ts --output prisma/auth.generated.prisma -y",
    "create-admin": "tsx --conditions=react-server --env-file-if-exists=.env scripts/create-admin.mts",
    "reencrypt-tokens": "tsx --conditions=react-server --env-file-if-exists=.env scripts/reencrypt-tokens.mts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@date-fns/tz": "1.5.0",
    "@hookform/resolvers": "7.0.6",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-auth": "1.7.22",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "date-fns": "4.4.0",
    "input-otp": "1.5.0",
    "lucide-react": "1.72.0",
    "next": "16.4.6",
    "next-themes": "0.4.6",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "qrcode.react": "4.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "undici": "8.12.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@testcontainers/postgresql": "12.2.1",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "auth": "1.7.22",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.6",
    "otpauth": "9.6.0",
    "pino-pretty": "13.2.0",
    "prettier": "3.10.1",
    "prisma": "7.10.1",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
